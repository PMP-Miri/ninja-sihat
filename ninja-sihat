<!doctype html>
<html lang="ms">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Tetak Gula</title>
<style>
  html,body{margin:0;height:100%;overflow:hidden;background:#1a0b16;font-family:system-ui,"Segoe UI",Roboto,sans-serif}
  canvas{display:block;width:100vw;height:100vh;cursor:none}
  video{display:none}
  #status{position:fixed;left:12px;bottom:8px;color:#ffffff88;font-size:13px;pointer-events:none}
</style>
</head>
<body>
<video id="cam" playsinline muted></video>
<canvas id="c"></canvas>
<div id="status">Memuatkan kamera…</div>

<script type="module">
import { FilesetResolver, HandLandmarker } from "https://cdn.jsdelivr.net/npm/@mediapipe/tasks-vision@0.10.14/vision_bundle.mjs";

/* =================== TETAPAN (ubah di sini) =================== */
const ROUND_SECONDS = 60;
const LIVES = 3;
const BAD_CHANCE = 0.72;
// PENTING: nilai sudu gula di bawah ialah ANGGARAN untuk prototaip (andaian 1 sudu teh ≈ 5 g).
// Sila semak & ganti dengan data pegawai dietetik / label produk sebelum digunakan di pameran.
const BAD = [
  { e: '🥤', name: 'Air bergas (1 tin)',     sudu: 7 },
  { e: '🧋', name: 'Bubble tea',             sudu: 8 },
  { e: '☕', name: 'Teh tarik manis',         sudu: 3 },
  { e: '🧃', name: 'Air kotak berperisa',     sudu: 5 },
  { e: '🍩', name: 'Donut bersalut gula',     sudu: 3 },
  { e: '🍰', name: 'Kek krim (1 potong)',     sudu: 5 },
  { e: '🍫', name: 'Coklat bar',              sudu: 5 },
  { e: '🍭', name: 'Lolipop',                 sudu: 2 },
  { e: '🍦', name: 'Aiskrim kon',             sudu: 4 },
];
const GOOD = [
  { e: '🍎', name: 'Epal' }, { e: '🍌', name: 'Pisang' }, { e: '🥕', name: 'Lobak merah' },
  { e: '🥦', name: 'Brokoli' }, { e: '🍉', name: 'Tembikai' }, { e: '💧', name: 'Air kosong' },
  { e: '🥒', name: 'Timun' }, { e: '🍊', name: 'Oren' },
];
// Mesej penutup. WHO: idealnya < 5% tenaga harian (~25 g, kira-kira 6 sudu teh) gula bebas untuk dewasa.
const LIMIT_MSG = 'WHO: idealnya kurang 6 sudu teh gula bebas sehari';

/* =================== KANVAS =================== */
const video = document.getElementById('cam');
const statusEl = document.getElementById('status');
const cv = document.getElementById('c');
const ctx = cv.getContext('2d');
let W = 0, H = 0, M = 0, R = 50, G = 1000;
function resize() {
  const dpr = Math.min(devicePixelRatio || 1, 2);
  W = innerWidth; H = innerHeight; M = Math.min(W, H);
  cv.width = W * dpr; cv.height = H * dpr;
  ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
  R = M * 0.07; G = H * 1.5;
}
addEventListener('resize', resize); resize();

/* =================== PENJEJAK TANGAN (hujung jari telunjuk) =================== */
let landmarker = null, lastVideoTime = -1, mouseMode = false;
const mouse = { x: 0, y: 0, seen: false };
const mkPtr = () => ({ x: W / 2, y: H / 2, vis: false, lost: 99, trail: [] });
const ptrs = [mkPtr(), mkPtr()];

async function makeLandmarker(vision, delegate) {
  return HandLandmarker.createFromOptions(vision, {
    baseOptions: {
      modelAssetPath: 'https://storage.googleapis.com/mediapipe-models/hand_landmarker/hand_landmarker/float16/1/hand_landmarker.task',
      delegate,
    },
    runningMode: 'VIDEO', numHands: 2,
    minHandDetectionConfidence: 0.5, minHandPresenceConfidence: 0.5, minTrackingConfidence: 0.5,
  });
}
async function initHands() {
  try {
    const stream = await navigator.mediaDevices.getUserMedia({ video: { width: 1280, height: 720, facingMode: 'user' }, audio: false });
    video.srcObject = stream; await video.play();
    statusEl.textContent = 'Memuatkan model tangan…';
    const vision = await FilesetResolver.forVisionTasks('https://cdn.jsdelivr.net/npm/@mediapipe/tasks-vision@0.10.14/wasm');
    try { landmarker = await makeLandmarker(vision, 'GPU'); }
    catch (e) { console.warn('GPU gagal, guna CPU', e); landmarker = await makeLandmarker(vision, 'CPU'); }
    statusEl.textContent = 'Kamera sedia · M = mod tetikus · F = skrin penuh';
  } catch (e) {
    console.error(e); mouseMode = true;
    statusEl.textContent = 'Kamera/model gagal dimuatkan (' + e.message + '). Mod tetikus aktif.';
  }
}
function camRect() {
  const vw = video.videoWidth || 1280, vh = video.videoHeight || 720;
  const s = Math.max(W / vw, H / vh), dw = vw * s, dh = vh * s;
  return { ox: (W - dw) / 2, oy: (H - dh) / 2, dw, dh };
}
const toScreen = (p, r) => ({ x: W - (r.ox + p.x * r.dw), y: r.oy + p.y * r.dh });

function updateHands(now) {
  if (mouseMode) {
    const p = ptrs[0]; p.vis = mouse.seen; p.x = mouse.x; p.y = mouse.y; p.lost = 0;
    ptrs[1].vis = false;
  } else if (landmarker && video.readyState >= 2 && video.currentTime !== lastVideoTime) {
    lastVideoTime = video.currentTime;
    const res = landmarker.detectForVideo(video, now);
    const r = camRect(), seen = [false, false];
    const hd = res.handednesses || res.handedness || [];
    res.landmarks.forEach((lm, i) => {
      let slot = hd[i] && hd[i][0] && hd[i][0].categoryName === 'Left' ? 0 : 1;
      if (seen[slot]) slot = 1 - slot;
      if (seen[slot]) return;
      seen[slot] = true;
      const p = ptrs[slot], s = toScreen(lm[8], r);   // 8 = hujung telunjuk
      const k = p.lost > 3 ? 1 : 0.7;
      if (p.lost > 3) p.trail.length = 0;
      p.x += (s.x - p.x) * k; p.y += (s.y - p.y) * k;
    });
    ptrs.forEach((p, i) => { p.lost = seen[i] ? 0 : p.lost + 1; p.vis = p.lost < 6; });
  }
  for (const p of ptrs) {
    if (!p.vis) { p.trail.length = 0; continue; }
    const lastPt = p.trail[p.trail.length - 1];
    if (!lastPt || lastPt.x !== p.x || lastPt.y !== p.y) p.trail.push({ x: p.x, y: p.y, t: now });
    while (p.trail.length && now - p.trail[0].t > 140) p.trail.shift();
  }
}

addEventListener('mousemove', e => { mouse.x = e.clientX; mouse.y = e.clientY; mouse.seen = true; });
addEventListener('mousedown', unlockAudio);
addEventListener('keydown', e => {
  unlockAudio();
  if (e.key === 'm' || e.key === 'M') { mouseMode = !mouseMode; statusEl.textContent = mouseMode ? 'Mod tetikus' : 'Mod kamera'; }
  if (e.key === 'f' || e.key === 'F') document.documentElement.requestFullscreen?.();
  if (e.key === ' ' && state !== 'play') startGame();
});

/* =================== BUNYI =================== */
let actx = null;
function unlockAudio() { try { actx = actx || new AudioContext(); actx.resume(); } catch (e) {} }
function beep(freq, dur = 0.12, type = 'sine', vol = 0.15, delay = 0, slideTo = 0) {
  if (!actx || actx.state !== 'running') return;
  const t = actx.currentTime + delay, o = actx.createOscillator(), g = actx.createGain();
  o.type = type; o.frequency.setValueAtTime(freq, t);
  if (slideTo) o.frequency.exponentialRampToValueAtTime(slideTo, t + dur);
  g.gain.setValueAtTime(vol, t); g.gain.exponentialRampToValueAtTime(0.001, t + dur);
  o.connect(g).connect(actx.destination); o.start(t); o.stop(t + dur);
}
const sfxSlice = () => beep(1400, 0.12, 'sawtooth', 0.06, 0, 300);
const sfxBad = () => { beep(220, 0.3, 'square', 0.1); beep(150, 0.35, 'square', 0.1, 0.12); };
const sfxCombo = () => [660, 880, 1100].forEach((f, i) => beep(f, 0.1, 'triangle', 0.12, i * 0.07));

/* =================== EMOJI & KESAN =================== */
const spriteCache = new Map();
function drawEmoji(e, x, y, size) {
  size = Math.round(size);
  const key = e + size;
  let c = spriteCache.get(key);
  if (!c) {
    c = document.createElement('canvas'); c.width = c.height = Math.ceil(size * 2.6);
    const g = c.getContext('2d');
    g.font = `${size * 2}px "Apple Color Emoji","Segoe UI Emoji","Noto Color Emoji",sans-serif`;
    g.textAlign = 'center'; g.textBaseline = 'middle';
    g.fillText(e, c.width / 2, c.width / 2 + size * 0.1);
    spriteCache.set(key, c);
  }
  ctx.drawImage(c, x - c.width / 4, y - c.height / 4, c.width / 2, c.height / 2);
}
function text(t, x, y, size, color = '#fff', align = 'center', weight = 800) {
  ctx.font = `${weight} ${size}px system-ui,"Segoe UI",Roboto,sans-serif`;
  ctx.textAlign = align; ctx.textBaseline = 'middle';
  ctx.lineWidth = Math.max(3, size * 0.14); ctx.strokeStyle = 'rgba(0,0,0,.6)'; ctx.lineJoin = 'round';
  ctx.strokeText(t, x, y); ctx.fillStyle = color; ctx.fillText(t, x, y);
}

const items = [], halves = [], parts = [], popups = [];
const popup = (lines, x, y, color, size = M * 0.032) => popups.push({ lines: [].concat(lines), x: Math.min(W - M * 0.2, Math.max(M * 0.2, x)), y, color, size, life: 1.6 });
function burst(x, y, color, n = 22) {
  for (let i = 0; i < n; i++) {
    const a = Math.random() * Math.PI * 2, s = 200 + Math.random() * 450;
    parts.push({ x, y, vx: Math.cos(a) * s, vy: Math.sin(a) * s - 200, life: 0.7 + Math.random() * 0.5, color, r: 3 + Math.random() * 6 });
  }
}

/* =================== LOGIK PERMAINAN =================== */
let state = 'title', timeLeft = 0, score = 0, lives = LIVES, sudu = 0, sliced = 0, spawnT = 0, endT = 0;
let combo = 0, comboT = 0, flash = 0, shake = 0, startItem = null;

const todayKey = () => 'tetak-best-' + new Date().toISOString().slice(0, 10);
const getBest = () => +(localStorage.getItem(todayKey()) || 0);

function launch(def, isBad, opts = {}) {
  const x0 = opts.x ?? W * (0.15 + Math.random() * 0.7);
  const h = opts.h ?? H * (0.55 + Math.random() * 0.3);
  const vy = -Math.sqrt(2 * G * h), tPeak = -vy / G;
  const vx = opts.vx ?? ((W / 2 - x0) / (2 * tPeak)) * (0.4 + Math.random() * 0.6);
  const it = { ...def, bad: isBad, x: x0, y: H + R, vx, vy, rot: 0, vr: (Math.random() - 0.5) * 4, r: opts.r ?? R, float: !!opts.float };
  items.push(it); return it;
}
function spawnWave() {
  const progress = 1 - timeLeft / ROUND_SECONDS;
  const n = Math.random() < 0.25 + progress * 0.35 ? 2 + (Math.random() < progress * 0.5 ? 1 : 0) : 1;
  for (let i = 0; i < n; i++) {
    const isBad = Math.random() < BAD_CHANCE;
    const pool = isBad ? BAD : GOOD;
    launch(pool[(Math.random() * pool.length) | 0], isBad);
  }
  spawnT = (1.25 - progress * 0.6) * (0.8 + Math.random() * 0.4);
}
function makeStartItem() {
  items.length = 0;
  startItem = { ...BAD[0], bad: true, x: W / 2, y: H * 0.56, vx: 0, vy: 0, rot: 0, vr: 0.6, r: M * 0.13, float: true, start: true };
  items.push(startItem);
}
makeStartItem();

function startGame() {
  unlockAudio();
  state = 'play'; timeLeft = ROUND_SECONDS; score = 0; lives = LIVES; sudu = 0; sliced = 0;
  combo = 0; comboT = 0; spawnT = 0.8; items.length = 0; popups.length = 0; startItem = null;
}
function endGame() {
  state = 'end'; endT = 0;
  if (score > getBest()) localStorage.setItem(todayKey(), score);
}

function segCircle(ax, ay, bx, by, cx, cy, r) {
  const dx = bx - ax, dy = by - ay, L2 = dx * dx + dy * dy || 1;
  const t = Math.max(0, Math.min(1, ((cx - ax) * dx + (cy - ay) * dy) / L2));
  const px = ax + t * dx - cx, py = ay + t * dy - cy;
  return px * px + py * py < r * r;
}
function split(it, ang) {
  for (const side of [-1, 1]) {
    halves.push({
      e: it.e, r: it.r, x: it.x, y: it.y, ang, side, rot: it.rot,
      vx: it.vx * 0.4 - Math.sin(ang) * side * 260, vy: Math.min(it.vy, 0) * 0.3 + Math.cos(ang) * side * 260 - 120,
      vr: side * (2 + Math.random() * 2), life: 1.8,
    });
  }
}
function slice(it, ang) {
  items.splice(items.indexOf(it), 1);
  split(it, ang);
  if (it.start) { burst(it.x, it.y, '#ff80ab', 40); sfxSlice(); startGame(); return; }
  if (it.bad) {
    sliced++; sudu += it.sudu; score += 1;
    combo++; comboT = 0.4;
    burst(it.x, it.y, '#ff80ab');
    popup([`${it.name}`, `≈ ${it.sudu} sudu teh gula`], it.x, it.y - it.r * 1.4, '#ffe082');
    sfxSlice();
  } else {
    lives--; flash = 0.5; shake = 0.4; combo = 0;
    burst(it.x, it.y, '#69f0ae');
    popup([`Alamak! ${it.name}`, 'itu pilihan sihat 💚'], it.x, it.y - it.r * 1.4, '#ff8a80');
    sfxBad();
    if (lives <= 0) endGame();
  }
}

function update(dt) {
  if (state === 'play') {
    timeLeft -= dt;
    spawnT -= dt;
    if (spawnT <= 0) spawnWave();
    if (comboT > 0) {
      comboT -= dt;
      if (comboT <= 0) {
        if (combo >= 3) { score += combo; popup([`COMBO x${combo}!`, `+${combo} bonus`], W / 2, H * 0.3, '#ffeb3b', M * 0.05); sfxCombo(); }
        combo = 0;
      }
    }
    if (timeLeft <= 0) endGame();
  }
  if (state === 'end') {
    endT += dt;
    if (endT > 12 || (endT > 2.5 && !startItem)) { if (!startItem) makeStartItem(); }
    if (endT > 20) state = 'title';
  }
  if (state === 'title' && !startItem) makeStartItem();

  // tetakan: gerakan laju hujung jari memotong objek
  const minSpeed = Math.max(700, H * 1.1);
  for (const p of ptrs) {
    const t = p.trail; if (t.length < 2) continue;
    const a = t[t.length - 2], b = t[t.length - 1];
    const span = (b.t - t[0].t) / 1000;
    let dist = 0; for (let i = 1; i < t.length; i++) dist += Math.hypot(t[i].x - t[i - 1].x, t[i].y - t[i - 1].y);
    if (span <= 0 || dist / span < minSpeed) continue;
    const ang = Math.atan2(b.y - a.y, b.x - a.x);
    for (const it of [...items]) {
      if (state === 'end' && !it.start) continue;
      if (segCircle(a.x, a.y, b.x, b.y, it.x, it.y, it.r)) slice(it, ang);
    }
  }

  for (let i = items.length - 1; i >= 0; i--) {
    const it = items[i];
    it.rot += it.vr * dt;
    if (it.float) { it.y = H * 0.56 + Math.sin(performance.now() / 500) * M * 0.02; continue; }
    it.vy += G * dt; it.x += it.vx * dt; it.y += it.vy * dt;
    if (it.vy > 0 && it.y > H + it.r * 2) items.splice(i, 1);
  }
  for (let i = halves.length - 1; i >= 0; i--) {
    const h = halves[i];
    h.vy += G * dt; h.x += h.vx * dt; h.y += h.vy * dt; h.rot += h.vr * dt; h.life -= dt;
    if (h.life <= 0 || h.y > H + h.r * 3) halves.splice(i, 1);
  }
  for (const q of parts) { q.life -= dt; q.vy += 900 * dt; q.x += q.vx * dt; q.y += q.vy * dt; }
  for (let i = parts.length - 1; i >= 0; i--) if (parts[i].life <= 0) parts.splice(i, 1);
  for (const pp of popups) { pp.life -= dt; pp.y -= dt * 35; }
  for (let i = popups.length - 1; i >= 0; i--) if (popups[i].life <= 0) popups.splice(i, 1);
  flash = Math.max(0, flash - dt); shake = Math.max(0, shake - dt);
}

/* =================== LUKISAN =================== */
function drawBackground() {
  if (!mouseMode && video.readyState >= 2) {
    const r = camRect();
    ctx.save(); ctx.translate(W, 0); ctx.scale(-1, 1);
    ctx.drawImage(video, r.ox, r.oy, r.dw, r.dh); ctx.restore();
    ctx.fillStyle = 'rgba(30,8,24,0.6)'; ctx.fillRect(0, 0, W, H);
  } else {
    const g = ctx.createRadialGradient(W / 2, H * 0.4, 0, W / 2, H * 0.4, Math.max(W, H) * 0.8);
    g.addColorStop(0, '#4a1238'); g.addColorStop(1, '#14060f');
    ctx.fillStyle = g; ctx.fillRect(0, 0, W, H);
  }
}
function drawItem(it) {
  ctx.save(); ctx.translate(it.x, it.y); ctx.rotate(it.rot);
  if (it.start) {
    ctx.beginPath(); ctx.arc(0, 0, it.r * 1.25, 0, Math.PI * 2);
    ctx.fillStyle = 'rgba(255,128,171,.2)'; ctx.fill();
    ctx.setLineDash([14, 10]); ctx.lineWidth = 4; ctx.strokeStyle = '#ff80ab'; ctx.stroke(); ctx.setLineDash([]);
  }
  drawEmoji(it.e, 0, 0, it.r);
  ctx.restore();
}
function drawHalf(h) {
  ctx.save(); ctx.globalAlpha = Math.min(1, h.life * 1.5);
  ctx.translate(h.x, h.y); ctx.rotate(h.ang + h.rot);
  ctx.beginPath(); ctx.rect(-h.r * 1.6, h.side < 0 ? -h.r * 1.6 : 0, h.r * 3.2, h.r * 1.6); ctx.clip();
  ctx.rotate(-h.ang);
  drawEmoji(h.e, 0, 0, h.r);
  ctx.restore();
}
function drawTrails() {
  ctx.lineCap = 'round'; ctx.lineJoin = 'round';
  for (const p of ptrs) {
    const t = p.trail;
    for (let i = 1; i < t.length; i++) {
      const a = i / t.length;
      ctx.strokeStyle = `rgba(255,255,255,${a})`; ctx.lineWidth = 2 + a * M * 0.018;
      ctx.shadowColor = '#ff80ab'; ctx.shadowBlur = 20;
      ctx.beginPath(); ctx.moveTo(t[i - 1].x, t[i - 1].y); ctx.lineTo(t[i].x, t[i].y); ctx.stroke();
    }
    ctx.shadowBlur = 0;
    if (p.vis) {
      ctx.beginPath(); ctx.arc(p.x, p.y, M * 0.012, 0, Math.PI * 2); ctx.fillStyle = '#fff'; ctx.fill();
    }
  }
}
function drawHUD() {
  text(`Skor ${score}`, W * 0.03, H * 0.06, M * 0.05, '#fff', 'left');
  text('❤️'.repeat(Math.max(0, lives)) + '🖤'.repeat(LIVES - Math.max(0, lives)), W * 0.03, H * 0.13, M * 0.04, '#fff', 'left');
  const t = Math.max(0, Math.ceil(timeLeft));
  text(`⏱ ${t}`, W * 0.97, H * 0.06, M * 0.05, t <= 10 ? '#ff8a80' : '#fff', 'right');
  text(`🥄 ${sudu} sudu gula ditetak`, W / 2, H * 0.06, M * 0.038, '#ffe082');
  text('Tetak yang manis · Jangan tetak buah, sayur & air kosong', W / 2, H * 0.115, M * 0.022, '#fce4ec', 'center', 600);
}
function drawTitle() {
  text('TETAK GULA!', W / 2, H * 0.15, M * 0.1, '#ff80ab');
  text('Hayun jari telunjuk untuk menetak makanan & minuman tinggi gula', W / 2, H * 0.25, M * 0.03, '#fff', 'center', 600);
  text('Elak buah, sayur & air kosong 🍎🥦💧', W / 2, H * 0.30, M * 0.03, '#b9f6ca', 'center', 600);
  text('👉 Tetak tin ini untuk MULA', W / 2, H * 0.80, M * 0.04, '#ffe082');
  const best = getBest();
  if (best) text(`Skor terbaik hari ini: ${best}`, W / 2, H * 0.88, M * 0.03, '#fff', 'center', 600);
}
function drawEnd() {
  ctx.fillStyle = 'rgba(0,0,0,.55)'; ctx.fillRect(0, 0, W, H);
  text(lives <= 0 ? 'NYAWA HABIS!' : 'MASA TAMAT!', W / 2, H * 0.12, M * 0.065);
  text(`Skor: ${score}`, W / 2, H * 0.22, M * 0.08, '#ffe082');
  text(`Anda menetak ≈ ${sudu} sudu teh gula 🥄`, W / 2, H * 0.32, M * 0.045, '#ff80ab');
  text(LIMIT_MSG, W / 2, H * 0.39, M * 0.028, '#fff', 'center', 600);
  if (score >= getBest() && score > 0) text('🏆 Skor terbaik hari ini!', W / 2, H * 0.80, M * 0.035, '#ffe082');
  else text(`Terbaik hari ini: ${getBest()}`, W / 2, H * 0.80, M * 0.03, '#eee', 'center', 600);
  if (startItem) text('👉 Tetak tin untuk main lagi', W / 2, H * 0.88, M * 0.032, '#ffe082');
  text('Nilai gula ialah anggaran', W / 2, H * 0.95, M * 0.018, '#bbb', 'center', 500);
}

function draw() {
  ctx.save();
  if (shake > 0) ctx.translate((Math.random() - 0.5) * 20 * shake, (Math.random() - 0.5) * 20 * shake);
  drawBackground();
  if (state === 'end') drawEnd();
  for (const h of halves) drawHalf(h);
  for (const it of items) drawItem(it);
  for (const q of parts) { ctx.globalAlpha = Math.max(0, q.life); ctx.fillStyle = q.color; ctx.beginPath(); ctx.arc(q.x, q.y, q.r, 0, Math.PI * 2); ctx.fill(); }
  ctx.globalAlpha = 1;
  for (const pp of popups) {
    ctx.globalAlpha = Math.min(1, pp.life);
    pp.lines.forEach((l, i) => text(l, pp.x, pp.y + i * pp.size * 1.15, pp.size * (i ? 0.85 : 1), pp.color));
  }
  ctx.globalAlpha = 1;
  if (state === 'play') drawHUD();
  if (state === 'title') drawTitle();
  drawTrails();
  if (flash > 0) { ctx.fillStyle = `rgba(255,0,0,${flash * 0.5})`; ctx.fillRect(-50, -50, W + 100, H + 100); }
  ctx.restore();
}

/* =================== GELUNG UTAMA =================== */
let last = performance.now();
function loop(now) {
  const dt = Math.min(0.05, (now - last) / 1000); last = now;
  updateHands(now);
  update(dt);
  draw();
  requestAnimationFrame(loop);
}
requestAnimationFrame(loop);
